# Copia este archivo a ".env" y completa los valores ahí — nunca en este
# archivo (este SÍ se sube a git; ".env" está en .gitignore).

# SQLite local por defecto (cero configuración). Para usar Postgres/Supabase
# más adelante, solo cambia esta URL — el resto del código no cambia:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/finanzas
DATABASE_URL=sqlite:///./finanzas.db

# Token del bot: crear uno NUEVO en Telegram con @BotFather (no reutilices
# el de otro proyecto). Sin esto, `python -m app.bot.main` falla al iniciar.
TELEGRAM_BOT_TOKEN=

# Chats de Telegram autorizados a usar el bot (separados por coma). Un bot
# es público: sin esta lista, cualquiera que lo encuentre podría escribir
# en tu base de datos. Si queda vacío, el bot no registra nada y solo le
# responde a quien le escriba con su chat_id: escríbele una vez, copia tu
# número aquí y reinicia el bot. Solo lo usa el bot, no el dashboard.
ALLOWED_CHAT_IDS=

DEFAULT_CURRENCY=PEN

# Valor inicial de referencia solo para la primera vez que se siembra la
# base de datos — después de eso, se edita desde el panel de configuración
# (Ajustes generales), no aquí.
MONTHLY_INCOME=4500

# --- Supabase Storage (fotos de comprobantes) ---
# Necesario en AMBOS entornos (bot y dashboard), ya que las fotos se guardan
# en un bucket privado en vez de en disco local (bot y dashboard corren en
# máquinas distintas y no comparten filesystem).
# Project URL (Project Settings -> API -> Project URL):
SUPABASE_URL=
# Service role key (Project Settings -> API -> service_role secret). Ignora
# RLS — por eso el bucket debe quedar privado y esta key NUNCA se sube a git.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del bucket creado para las fotos de comprobantes:
SUPABASE_RECEIPTS_BUCKET=receipts

# --- Acceso al panel/dashboard (obligatorio) ---
# Sin esto, app/webapp/config_app.py se niega a arrancar (falla cerrado en
# vez de quedar público sin protección por error). Solo lo usa el dashboard,
# no el bot. En Streamlit Community Cloud se define en Secrets, no aquí.
DASHBOARD_PASSWORD=
